# Copy to .env  (docker compose reads it; for local dev export the same variables or put them in server/.env)

# --- required in production
JWT_SECRET=change-me-to-a-long-random-string
# 64 hex chars (32 bytes). Encrypts Google refresh tokens at rest.   openssl rand -hex 32
TOKEN_ENC_KEY=

# --- optional integrations (the app works without all of them)
OPENAI_API_KEY=               # without it, visit summaries use the deterministic template fallback
OPENAI_MODEL=gpt-4o-mini
SMTP_HOST=                    # without it, emails are logged instead of sent
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Clinic <no-reply@clinic.local>
GOOGLE_CLIENT_ID=             # enables "Connect Google Calendar" for doctors
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/calendar/callback

# --- web
CLIENT_URL=http://localhost:5173          # where the OAuth callback sends the doctor back to
CORS_ORIGIN=http://localhost:5173         # comma-separated allowlist
TRUST_PROXY=                              # "1" when running behind one reverse proxy
LOG_REQUESTS=true
